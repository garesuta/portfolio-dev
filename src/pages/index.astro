---
import '../styles/global.css';
import { bio, contact, jobs, schools, stack } from '../data/content';
import { SPACER_VH } from '../lib/story';

const words = (text: string) => text.split(' ').map((w) => `${w} `);
// Galaxy labels: letters slide in nearest the galaxy first (left label staggers right-to-left).
const letters = (text: string, left: boolean) =>
  [...text].map((ch, i, all) => ({
    ch: ch === ' ' ? ' ' : ch,
    style: `--delay:${((left ? all.length - 1 - i : i) / 10).toFixed(1)}s;--shift:${left ? -44 : 44}px`,
  }));
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Noppadol Chinonn · Full-Stack Software Engineer</title>
<meta name="description" content="Noppadol Chinonn, Mid-Level Full-Stack Software Engineer: TypeScript, JavaScript, Python and Go.">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;700&display=swap" rel="stylesheet">
</head>
<body>
<nav class="contact" aria-label="Contact">
  <a href={`mailto:${contact.email}`}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M3 5.5h18v13H3z M3.5 6l8.5 7 8.5-7"/></svg>Email</a><span aria-hidden="true">·</span>
  <a href={contact.github} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>GitHub</a><span aria-hidden="true">·</span>
  <a href={contact.linkedin} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>LinkedIn</a>
</nav>
<div class="backdrop" aria-hidden="true">
  <div class="ambient"></div>
  <div class="vignette"></div>
</div>
<div class="chrome" aria-hidden="true">
  <div class="frame">
    <p class="label labelLeft">{letters('Clarity in', true).map((l) => <span class="letter" style={l.style}>{l.ch}</span>)}</p>
    <p class="label labelRight">{letters('the unknown.', false).map((l) => <span class="letter" style={l.style}>{l.ch}</span>)}</p>
  </div>
</div>
<main>
  <h1 class="sr">Noppadol Chinonn, Full-Stack Software Engineer</h1>
  <div class="hero">
    <div class="scene" aria-hidden="true">
      <!-- .field (WebGL) is inserted here, before .type: the sibling selectors depend on it -->
      <div class="type">
        <p class="title"><span>Noppadol</span><span>Chinonn</span></p>
        <p class="role">Full-Stack Software Engineer</p>
      </div>
    </div>
    <p class="scrollHint" aria-hidden="true">Scroll to explore</p>
  </div>
  <section class="converge" aria-label="Clarity in the unknown" style={`height:${SPACER_VH * 100}vh`}></section>
  <section id="about" aria-labelledby="about-heading">
    <h2 id="about-heading">about me</h2>
    <p class="bio">{words(bio.focus).map((w) => <span class="word focus">{w}</span>)}{words(bio.rest).map((w) => <span class="word">{w}</span>)}</p>
  </section>
  <div id="skills">
    <div class="stack-wrap">
      <section id="my-stack" aria-labelledby="stack-heading">
        <h2 id="stack-heading">my stack</h2>
        {stack.map((row) => (
          <div class="row">
            <p class="category">{row.category}</p>
            <ul>{row.tools.map((t) => <li>{t.icon && <img src={t.icon} alt="" />}{t.name}</li>)}</ul>
          </div>
        ))}
      </section>
    </div>
  </div>
  <section id="experience" class="timeline" aria-labelledby="experience-heading">
    <h2 id="experience-heading">experience</h2>
    {jobs.map((j) => (
      <div class="row">
        <p class="category">{j.period}</p>
        <div class="job"><h3>{j.role}</h3><p class="org">{j.org}</p><p class="what">{j.what}</p></div>
      </div>
    ))}
  </section>
  <section id="education" class="timeline" aria-labelledby="education-heading">
    <h2 id="education-heading">education</h2>
    {schools.map((s) => (
      <div class="row">
        <p class="category">{s.period}</p>
        <div class="school"><img src={s.logo} alt="" /><div><h3>{s.degree}</h3><p class="org">{s.org}</p></div></div>
      </div>
    ))}
  </section>
</main>
<script>
  import '../scripts/hero';
  import '../scripts/galaxy';
  import '../scripts/reveals';
</script>
</body>
</html>
